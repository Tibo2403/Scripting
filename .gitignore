# Ignore penetration test results
pentest_results/

# Ignore wifi capture files
wifi_captures/

# Ignore log files and temporary logs
*.log
*.tmp
logs/

# Ignore Python cache files
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
deploy/akash-openclaw-doc-agent/deploy.resolved.yaml
.venv/
venv/

# Ignore local environment files, but keep templates tracked
.env
.env.*
!.env.example

# Ignore local tabular data files
*.csv

# Independent local checkout (has its own Git history).
/LinkedGpt/

# JavaScript dependencies and generated build output
node_modules/
dist/
*.tsbuildinfo

# Keep sanitized examples tracked.
!examples/*.csv
