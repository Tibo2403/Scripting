# Chemin absolu vers le projet CrewAI
CREWAI_PROJECT_DIR=/opt/crewai/project

# Chemin relatif, obligatoirement à l'intérieur du projet
CREWAI_TASKS_FILE=config/tasks.yaml

# Fichier de définition des agents CrewAI
CREWAI_AGENTS_FILE=config/agents.yaml

# Durée de validité d'une proposition en secondes
CREWAI_PROPOSAL_TTL=900

# Répertoire persistant et inscriptible dans le conteneur
CREWAI_ADMIN_STATE_DIR=/var/lib/openclaw-crewai-admin
